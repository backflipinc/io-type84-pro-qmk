+tap_dance_action_t* tap_dance_get(uint16_t tap_dance_idx) {
+    if (tap_dance_idx >= VIAL_TAP_DANCE_ENTRIES)
+        return NULL;
+    return &tap_dance_actions[tap_dance_idx];
+}
