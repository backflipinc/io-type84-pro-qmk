USB HID battery report for QMK (SonixQMK sn32_develop @ b7b245d0)

Enabled with OPT_DEFS += -DHID_BATTERY_ENABLE (see keyboards/io/type84_pro/rules.mk).

- report.h: new REPORT_ID_BATTERY.
- usb_descriptor.c: Generic Device Controls / Battery Strength (0-100) and
  Battery System / Charging (1 bit) on the shared endpoint, so Linux (hid-input,
  UPower) shows the keyboard battery over USB. The System Control collection is
  narrowed to 0x81-0x83 (power/sleep/wake): the full 0x01-0xB7 range contains
  Generic Desktop axes, which made udev classify the interface as a joystick.
- chibios/usb_endpoints.c: store the battery report so GET_REPORT is answered
  (the kernel reads the level that way when the device is probed).

Applied by ../setup.sh.

diff --git a/tmk_core/protocol/chibios/usb_endpoints.c b/tmk_core/protocol/chibios/usb_endpoints.c
index 00536845..e76ffaa1 100644
--- a/tmk_core/protocol/chibios/usb_endpoints.c
+++ b/tmk_core/protocol/chibios/usb_endpoints.c
@@ -42,6 +42,10 @@ usb_endpoint_in_t usb_endpoints_in[USB_ENDPOINT_IN_COUNT] = {
 #endif
 #if defined(DIGITIZER_SHARED_EP)
         QMK_USB_REPORT_STROAGE_ENTRY(REPORT_ID_DIGITIZER, sizeof(report_digitizer_t)),
+#endif
+#if defined(HID_BATTERY_ENABLE)
+        // the Linux kernel reads the battery level with GET_REPORT when the device is probed
+        QMK_USB_REPORT_STROAGE_ENTRY(REPORT_ID_BATTERY, 3),
 #endif
         )
     ),
diff --git a/tmk_core/protocol/report.h b/tmk_core/protocol/report.h
index 9053b0bb..cf5fc621 100644
--- a/tmk_core/protocol/report.h
+++ b/tmk_core/protocol/report.h
@@ -39,7 +39,12 @@ enum hid_report_ids {
     REPORT_ID_NKRO,
     REPORT_ID_JOYSTICK,
     REPORT_ID_DIGITIZER,
+#ifdef HID_BATTERY_ENABLE
+    REPORT_ID_BATTERY,
+    REPORT_ID_COUNT = REPORT_ID_BATTERY
+#else
     REPORT_ID_COUNT = REPORT_ID_DIGITIZER
+#endif
 };
 
 #define IS_VALID_REPORT_ID(id) ((id) >= REPORT_ID_ALL && (id) <= REPORT_ID_COUNT)
diff --git a/tmk_core/protocol/usb_descriptor.c b/tmk_core/protocol/usb_descriptor.c
index ceab9eef..d3fef61e 100644
--- a/tmk_core/protocol/usb_descriptor.c
+++ b/tmk_core/protocol/usb_descriptor.c
@@ -365,10 +365,20 @@ const USB_Descriptor_HIDReport_Datatype_t PROGMEM SharedReport[] = {
     HID_RI_USAGE(8, 0x80),                // System Control
     HID_RI_COLLECTION(8, 0x01),           // Application
         HID_RI_REPORT_ID(8, REPORT_ID_SYSTEM),
+#ifdef HID_BATTERY_ENABLE
+        // Only what QMK actually sends (power / sleep / wake). The full 0x01..0xB7
+        // range includes Generic Desktop axes (X/Y, D-pad -> ABS_HAT), so udev tags the
+        // interface as a joystick and UPower shows the keyboard battery as "gaming input"
+        HID_RI_USAGE_MINIMUM(8, 0x81),    // System Power Down
+        HID_RI_USAGE_MAXIMUM(16, 0x0083), // System Wake Up
+        HID_RI_LOGICAL_MINIMUM(8, 0x81),
+        HID_RI_LOGICAL_MAXIMUM(16, 0x0083),
+#else
         HID_RI_USAGE_MINIMUM(8, 0x01),    // Pointer
         HID_RI_USAGE_MAXIMUM(16, 0x00B7), // System Display LCD Autoscale
         HID_RI_LOGICAL_MINIMUM(8, 0x01),
         HID_RI_LOGICAL_MAXIMUM(16, 0x00B7),
+#endif
         HID_RI_REPORT_COUNT(8, 1),
         HID_RI_REPORT_SIZE(8, 16),
         HID_RI_INPUT(8, HID_IOF_DATA | HID_IOF_ARRAY | HID_IOF_ABSOLUTE),
@@ -388,6 +398,33 @@ const USB_Descriptor_HIDReport_Datatype_t PROGMEM SharedReport[] = {
     HID_RI_END_COLLECTION(0),
 #endif
 
+#ifdef HID_BATTERY_ENABLE
+    // Battery level 0..100 % (Linux: hid-input -> power_supply)
+    HID_RI_USAGE_PAGE(8, 0x06),            // Generic Device Controls
+    HID_RI_USAGE(8, 0x20),                 // Battery Strength
+    HID_RI_COLLECTION(8, 0x01),            // Application
+        HID_RI_REPORT_ID(8, REPORT_ID_BATTERY),
+        HID_RI_USAGE_PAGE(8, 0x06),        // Generic Device Controls
+        HID_RI_USAGE(8, 0x20),             // Battery Strength
+        HID_RI_LOGICAL_MINIMUM(8, 0),
+        HID_RI_LOGICAL_MAXIMUM(8, 100),
+        HID_RI_REPORT_COUNT(8, 1),
+        HID_RI_REPORT_SIZE(8, 8),
+        HID_RI_INPUT(8, HID_IOF_DATA | HID_IOF_VARIABLE | HID_IOF_ABSOLUTE),
+        // Charging (1 bit) + 7 bits of padding
+        HID_RI_USAGE_PAGE(8, 0x85),        // Battery System
+        HID_RI_USAGE(8, 0x44),             // Charging
+        HID_RI_LOGICAL_MINIMUM(8, 0),
+        HID_RI_LOGICAL_MAXIMUM(8, 1),
+        HID_RI_REPORT_COUNT(8, 1),
+        HID_RI_REPORT_SIZE(8, 1),
+        HID_RI_INPUT(8, HID_IOF_DATA | HID_IOF_VARIABLE | HID_IOF_ABSOLUTE),
+        HID_RI_REPORT_COUNT(8, 1),
+        HID_RI_REPORT_SIZE(8, 7),
+        HID_RI_INPUT(8, HID_IOF_CONSTANT),
+    HID_RI_END_COLLECTION(0),
+#endif
+
 #ifdef PROGRAMMABLE_BUTTON_ENABLE
     HID_RI_USAGE_PAGE(8, 0x0C),            // Consumer
     HID_RI_USAGE(8, 0x01),                 // Consumer Control
